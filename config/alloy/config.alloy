// ###############################
// #### Metrics Configuration ####
// ###############################

prometheus.exporter.cadvisor "sandol_docker_metrics" {
  docker_host = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}


// Configure a prometheus.scrape component to collect cadvisor metrics.
prometheus.scrape "scraper" {
  targets    = prometheus.exporter.cadvisor.sandol_docker_metrics.targets
  forward_to = [ prometheus.remote_write.prometheus_storage.receiver ]


  scrape_interval = "10s"
}

// Configure a prometheus.remote_write component to send metrics to a Prometheus server.
prometheus.remote_write "prometheus_storage" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ###############################
// #### Logging Configuration ####
// ###############################

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "strip_slash_and_filter_sandol_team" {
  targets = discovery.docker.containers.targets

  // 같은 호스트의 다른 compose project 로그가 섞이지 않게 프로젝트명을 고정한다.
  // .env 의 COMPOSE_PROJECT_NAME 과 일치해야 한다.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "sandol_team"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "alloy|loki|prometheus|grafana"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    target_label  = "platform"
    replacement   = "docker"
  }
}

loki.source.docker "sandol" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.strip_slash_and_filter_sandol_team.output
  relabel_rules = discovery.relabel.strip_slash_and_filter_sandol_team.rules

  forward_to = [loki.process.sandol.receiver]
}

loki.process "sandol" {
  // 성공한 health check 만 버린다. 2xx 로 제한해서 실패한 것은 남긴다.
  // 앞 대안은 uvicorn 접근 로그, 뒤 대안은 경로가 / 인 NestJS health check 다.
  // 경로 뒤에 경계를 두지 않으면 GET 요청 로그 전체가 걸린다.
  stage.drop {
    expression = "(GET|HEAD) (/[a-z0-9-]+)*/health(/live)? HTTP/1\\.[01]\" 2[0-9][0-9]|GET / 2[0-9][0-9] [0-9]+ - curl/"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

logging {
  level  = "warn"
  format = "json"
}
